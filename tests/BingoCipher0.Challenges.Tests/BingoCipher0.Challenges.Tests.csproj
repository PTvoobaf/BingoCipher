    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BingoCipher0.Challenges\BingoCipher0.Challenges.csproj" />
  </ItemGroup>
</Project>
